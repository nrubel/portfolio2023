[{"id":"flyhub-hrms","title":"Flyhub HRMS","slug":"flyhub-hrms","category":"Enterprise Web App","featured":true,"status":"production","thumbnail":"/images/flyhub-hrms.webp","liveUrl":"https://app.hrms.flyhub.com","githubUrl":"","startDate":"2021-03","endDate":null,"isCurrent":true,"shortDesc":"Enterprise-grade Human Resource Management System built for Flyhub's 100+ member organization.","fullDesc":"A full-featured web-based HRMS built entirely from scratch — both frontend and backend — to manage Flyhub's internal HR operations. The system handles employee onboarding, leave management, attendance tracking, performance workflows, and organizational hierarchy visualization.\n\nFrontend is built with React + TypeScript + Redux for predictable state management. The REST API backend is powered by Express + MongoDB + Mongoose. The platform continues to grow with new modules and integrations.","highlights":["Sole architect and developer of both frontend and backend","Serves 100+ active employees in production","Real-time notifications using Socket.io","Role-based access control (RBAC) with granular permissions"],"techStack":["React","TypeScript","Redux","Node.js","Express","MongoDB","Mongoose","Socket.io","TailwindCSS"]},{"id":"flyhub-faces","title":"Faces of Flyhub","slug":"flyhub-faces","category":"Web Platform","featured":true,"status":"production","thumbnail":"/images/flyhub-faces.webp","liveUrl":"https://faces.flyhub.com","githubUrl":"","startDate":"2021-06","endDate":"2021-10","isCurrent":false,"shortDesc":"Employee profile platform combining internal recognition with public-facing team showcasing for Flyhub.","fullDesc":"A public-facing employee directory and profile platform where Flyhub team members can build personal professional profiles. Built with React on the frontend and Express + MongoDB on the backend, featuring public profile URLs and shareable profile links used in recruitment and client communication.","highlights":["Public shareable profile URLs for ea